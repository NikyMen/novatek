---
export const prerender = true;
import SiteLayout from '../layouts/SiteLayout.astro';

const WA = 'https://wa.link/fo0jrt';

const categorias = [
  { n: 'Escuadras', img: '/img/categoria-escuadras.png' },
  { n: 'Manijas', img: '/img/categoria-manijas.png' },
  { n: 'Bisagras', img: '/img/categoria-bisagras.png' },
  { n: 'Cierres Laterales', img: '/img/categoria-cierres-laterales.png' },
  { n: 'Fallebas', img: '/img/categoria-fallebas.png' },
  { n: 'Oscilobatientes', img: '/img/categoria-oscilobatientes.png' },
  { n: 'Elevables', img: '/img/categoria-elevables.png' },
];

const marcas = [
  { n: 'Roto', img: '/img/marca-1.png' },
  { n: 'Fapim', img: '/img/marca-2.png' },
  { n: 'Monticelli', img: '/img/marca-3.png' },
  { n: 'Comunello', img: '/img/marca-4.png' },
  { n: 'Giesse', img: '/img/marca-5.png' },
];

const carrusel = [
  '/carrusel/carrusel-1.jpeg',
  '/carrusel/carrusel-2.jpeg',
  '/carrusel/carrusel-3.jpeg',
  '/carrusel/carrusel-4.jpeg',
  '/carrusel/carrusel-5.jpeg',
  '/carrusel/carrusel-6.jpeg',
  '/carrusel/carrusel-7.jpeg',
  '/carrusel/carrusel-8.jpeg',
  '/carrusel/carrusel-9.jpeg',
  '/carrusel/carrusel-10.jpeg',
  '/carrusel/carrusel-11.jpeg',
  '/carrusel/carrusel-12.jpeg',
];

const showMundialStockSection = false;
---

<SiteLayout title="Novatek Argentina">
  <!-- ============ HERO ============ -->
  <section class="relative isolate overflow-hidden bg-navy-gradient pt-28 md:pt-36 pb-20 md:pb-28">
    <div class="absolute inset-0 -z-10 bg-pitch-glow"></div>
    <div class="field-lines absolute inset-0 -z-10 opacity-50"></div>
    <!-- franja celeste/blanca argentina sutil -->
    <div class="absolute -top-24 -right-24 -z-10 h-[480px] w-[480px] rounded-full bg-brand-500/20 blur-[120px]"></div>
    <div class="absolute -bottom-32 -left-20 -z-10 h-[420px] w-[420px] rounded-full bg-celeste/10 blur-[120px]"></div>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-8 items-center">
        <!-- Texto -->
        <div data-reveal>
          <h1 class="font-display text-5xl sm:text-6xl xl:text-7xl leading-[0.92] tracking-tight text-white">
            PIEZAS CLAVES<br />
            PARA <span class="text-brand-500">GRANDES</span><br />
            PROYECTOS
          </h1>

          <p class="mt-6 max-w-xl text-base md:text-lg leading-relaxed text-white/70">
            <mark class="rounded-md bg-brand-500/90 px-2 py-0.5 font-semibold text-white">Accesorios y herrajes para aluminio y PVC</mark>
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a href="/catalogo" class="group inline-flex items-center gap-2 rounded-full bg-orange-gradient px-7 py-4 font-bold text-white shadow-glow transition-transform hover:scale-105">
              Ver catálogo
              <svg class="h-5 w-5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a href={WA} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-7 py-4 font-bold text-white backdrop-blur transition-colors hover:bg-white/10">
              Contactanos
            </a>
          </div>
        </div>

        <!-- Contador campaña -->
        <div class="relative" data-reveal style="--reveal-delay:150ms">
          <div class="absolute inset-0 -z-10 translate-x-6 translate-y-6 rounded-[2rem] bg-brand-500/20 blur-2xl"></div>
          <div class="magnet-counter relative overflow-hidden rounded-[1.1rem] border border-white/10 bg-[#050607] p-3 shadow-card transition-transform duration-500 hover:-translate-y-1 sm:rounded-[1.35rem] sm:p-4" aria-label="Contador 99 horas, 99 minutos y 99 segundos">
            <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_var(--mx,50%)_var(--my,50%),rgba(242,106,27,0.24),transparent_30%),linear-gradient(135deg,rgba(255,255,255,0.16),transparent_24%,rgba(255,255,255,0.03)_52%,transparent_72%)]"></div>
            <div class="pointer-events-none absolute inset-x-4 top-2 h-px bg-gradient-to-r from-transparent via-white/35 to-transparent"></div>
            <div class="relative rounded-[0.85rem] border border-white/10 bg-[#05070a] px-2 py-5 shadow-[inset_0_0_24px_rgba(0,0,0,0.9)] sm:rounded-[1rem] sm:px-4 sm:py-7">
              <div class="counter-scanline"></div>
              <div class="counter-display">
                {['hours', 'minutes', 'seconds'].map((group, groupIndex) => (
                  <>
                    {groupIndex > 0 && (
                      <span class="counter-separator" aria-hidden="true">
                        <span></span>
                        <span></span>
                      </span>
                    )}
                    <div class="counter-unit" data-counter-group={group}>
                      {Array.from({ length: 2 }).map(() => (
                        <span class="counter-digit" data-value="9" aria-hidden="true">
                          {['a', 'b', 'c', 'd', 'e', 'f', 'g'].map((segment) => (
                            <span class={`counter-segment segment-${segment}`}></span>
                          ))}
                        </span>
                      ))}
                    </div>
                  </>
                ))}
                <span class="sr-only">99:99:99</span>
              </div>
            </div>
            <div class="counter-labels relative mt-4 text-[0.68rem] font-bold uppercase tracking-[0.22em] text-white/55">
              <span>Horas</span>
              <span>Minutos</span>
              <span>Segundos</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ola inferior -->
    <div class="pointer-events-none absolute bottom-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-brand-500/60 to-transparent"></div>
  </section>

  <!-- ============ TIRA DE VALORES (marquee) ============ -->
  <section class="border-y border-white/10 bg-navy-800 py-5 overflow-hidden">
    <div class="flex w-max animate-marquee gap-12 whitespace-nowrap">
      {Array.from({ length: 2 }).map(() => (
        <div class="flex items-center gap-12">
          {['Calidad', 'Precisión', 'Respaldo', 'Durabilidad', 'Seguridad', 'Stock real', 'Asesoramiento'].map((w) => (
            <span class="flex items-center gap-4">
              <span class="font-display text-2xl tracking-wide text-white/85">{w}</span>
              <span class="text-brand-500">✦</span>
            </span>
          ))}
        </div>
      ))}
    </div>
  </section>

  <!-- ============ NOSOTROS / DT ============ -->
  {showMundialStockSection && (
    <section class="relative overflow-hidden py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div>
          <div class="relative" data-reveal>
            <div class="absolute -inset-3 -z-10 rounded-[2rem] bg-gradient-to-tr from-brand-500/20 to-celeste/10 blur-xl"></div>
            <img src="/mundial/dirige-bandera.jpeg" alt="¿Quién dirige tu proyecto? — Novatek" class="w-full rounded-[2rem] border border-white/10 shadow-card" loading="lazy" />
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ============ CATEGORÍAS / PLANTEL ============ -->
  <section class="relative py-20 md:py-28 bg-navy-800 border-y border-white/10">
    <div class="field-lines absolute inset-0 opacity-40"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <div class="flex items-center justify-center gap-3">
          <span class="slashes"><span></span><span></span><span></span></span>
          <span class="text-xs font-bold uppercase tracking-widest2 text-brand-400">Nuestro plantel</span>
        </div>
        <h2 class="mt-5 font-display text-4xl md:text-5xl text-white">Catalogo</h2>
      </div>

      <div class="mt-14 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5">
        {categorias.map((c, i) => (
          <a href="/catalogo" class="group relative overflow-hidden rounded-2xl border border-white/10 bg-navy-900 shadow-card" data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <div class="aspect-square overflow-hidden">
              <img src={c.img} alt={c.n} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110" loading="lazy" />
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-navy-950 via-navy-950/30 to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 flex items-center justify-between p-4">
              <span class="font-display text-lg md:text-xl tracking-wide text-white">{c.n.toUpperCase()}</span>
              <span class="grid h-8 w-8 place-items-center rounded-full bg-brand-500 text-white opacity-0 -translate-x-2 transition-all duration-300 group-hover:opacity-100 group-hover:translate-x-0">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </div>
          </a>
        ))}
        <a href="/catalogo" class="group relative flex flex-col items-center justify-center gap-3 rounded-2xl border border-dashed border-brand-500/40 bg-brand-500/5 p-6 text-center transition-colors hover:bg-brand-500/10" data-reveal style={`--reveal-delay:${categorias.length * 70}ms`}>
          <span class="grid h-12 w-12 place-items-center rounded-full bg-orange-gradient text-white shadow-glow-sm">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <span class="font-display text-xl text-white">VER TODO<br/>EL CATÁLOGO</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ MARCAS ============ -->
  <section class="py-20 md:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center" data-reveal>
        <h2 class="font-display text-3xl md:text-4xl text-white">MARCAS QUE NOS ACOMPAÑAN</h2>
        <p class="mt-3 text-white/55">Nuestro equipo de estrellas internacionales.</p>
      </div>
      <div class="mt-12 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-5" data-reveal>
        {marcas.map((m) => (
          <div class="group grid place-items-center rounded-2xl border border-white/10 bg-white px-2 py-3 transition-transform hover:-translate-y-1">
            <img src={m.img} alt={m.n} class="h-28 md:h-32 w-full object-contain opacity-90 transition group-hover:opacity-100" loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CARRUSEL ============ -->
  <section class="relative overflow-hidden py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div id="carrusel" class="relative overflow-hidden rounded-[2.5rem] border border-brand-500/20 bg-navy-800 shadow-card" data-reveal>
        <!-- Slides -->
        <div id="carrusel-track" class="flex transition-transform duration-700 ease-out">
          {carrusel.map((img, i) => (
            <div class="relative w-full shrink-0">
              <img src={img} alt={`Novatek — imagen ${i + 1}`} class="aspect-[16/9] w-full bg-navy-900 object-contain" loading={i === 0 ? 'eager' : 'lazy'} />
            </div>
          ))}
        </div>

        <!-- Flechas -->
        <button id="carrusel-prev" aria-label="Anterior"
          class="absolute left-4 top-1/2 -translate-y-1/2 grid h-11 w-11 place-items-center rounded-full bg-navy-900/70 text-white ring-1 ring-white/15 backdrop-blur transition hover:bg-brand-500">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button id="carrusel-next" aria-label="Siguiente"
          class="absolute right-4 top-1/2 -translate-y-1/2 grid h-11 w-11 place-items-center rounded-full bg-navy-900/70 text-white ring-1 ring-white/15 backdrop-blur transition hover:bg-brand-500">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>

        <!-- Indicadores -->
        <div id="carrusel-dots" class="absolute inset-x-0 bottom-5 flex items-center justify-center gap-2.5">
          {carrusel.map((_, i) => (
            <button data-idx={i} aria-label={`Ir a la imagen ${i + 1}`}
              class="carrusel-dot h-2.5 w-2.5 rounded-full bg-white/40 transition-all hover:bg-white/70"></button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <style>
    .magnet-counter {
      --mx: 50%;
      --my: 50%;
      width: min(100%, 34rem);
      isolation: isolate;
      margin-inline: auto;
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.18),
        inset -18px -14px 28px rgba(255, 255, 255, 0.035),
        inset 18px 12px 28px rgba(255, 255, 255, 0.04),
        0 26px 60px rgba(0, 0, 0, 0.42),
        0 0 42px rgba(242, 106, 27, 0.14);
    }

    .magnet-counter::before {
      content: "";
      position: absolute;
      inset: -35%;
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.18), transparent 16%),
        linear-gradient(90deg, rgba(255, 255, 255, 0.08), transparent 22%, transparent 74%, rgba(255, 255, 255, 0.05));
      opacity: 0.55;
      transform: translate3d(0, 0, 0);
      transition: opacity 300ms ease;
    }

    .magnet-counter:hover::before {
      opacity: 0.85;
      animation: counter-field 900ms ease-in-out infinite alternate;
    }

    .counter-display {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      max-width: 30rem;
      margin-inline: auto;
      gap: clamp(0.18rem, 0.65vw, 0.48rem);
    }

    .counter-unit {
      display: flex;
      gap: clamp(0.16rem, 0.5vw, 0.34rem);
      border-radius: 0.45rem;
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.06), transparent 34%),
        #121820;
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.08),
        inset 0 -12px 22px rgba(0, 0, 0, 0.45);
      padding: clamp(0.26rem, 0.7vw, 0.5rem);
      transition: filter 180ms ease, background 180ms ease;
    }

    .counter-unit.is-scrambling {
      background:
        radial-gradient(circle at center, rgba(242, 106, 27, 0.14), transparent 68%),
        #151820;
      filter: drop-shadow(0 0 20px rgba(242, 106, 27, 0.5));
    }

    .counter-separator {
      display: inline-grid;
      align-content: center;
      place-items: center;
      gap: clamp(0.34rem, 0.9vw, 0.68rem);
      width: clamp(0.38rem, 0.9vw, 0.68rem);
      align-self: stretch;
    }

    .counter-digit {
      --segment-size: clamp(0.25rem, 0.68vw, 0.5rem);
      position: relative;
      width: clamp(1.6rem, 4vw, 3.35rem);
      height: clamp(3.05rem, 7.5vw, 6.2rem);
      border-radius: 0.25rem;
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.045), transparent 32%),
        linear-gradient(90deg, rgba(255, 255, 255, 0.035), transparent 20%, transparent 80%, rgba(255, 255, 255, 0.025)),
        #0a0d12;
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.08),
        inset 0 0 18px rgba(0, 0, 0, 0.8);
      flex: 0 0 auto;
    }

    .counter-separator span {
      width: clamp(0.34rem, 0.78vw, 0.52rem);
      aspect-ratio: 1;
      border-radius: 0.08rem;
      background: #f26a1b;
      box-shadow:
        0 0 7px rgba(242, 106, 27, 0.9),
        0 0 18px rgba(242, 106, 27, 0.58);
      transform: skewX(-5deg);
    }

    .counter-segment {
      position: absolute;
      display: block;
      background: rgba(242, 106, 27, 0.1);
      filter: saturate(0.7);
      opacity: 0.42;
      transition: opacity 70ms linear, background-color 70ms linear, box-shadow 70ms linear;
    }

    .segment-a,
    .segment-d,
    .segment-g {
      left: calc(var(--segment-size) * 0.86);
      right: calc(var(--segment-size) * 0.86);
      height: var(--segment-size);
      clip-path: polygon(12% 0, 88% 0, 100% 50%, 88% 100%, 12% 100%, 0 50%);
    }

    .segment-a {
      top: calc(var(--segment-size) * 0.46);
    }

    .segment-g {
      top: 50%;
      transform: translateY(-50%);
    }

    .segment-d {
      bottom: calc(var(--segment-size) * 0.46);
    }

    .segment-b,
    .segment-c,
    .segment-e,
    .segment-f {
      width: var(--segment-size);
      height: calc(50% - (var(--segment-size) * 1.28));
      clip-path: polygon(50% 0, 100% 12%, 100% 88%, 50% 100%, 0 88%, 0 12%);
    }

    .segment-b,
    .segment-c {
      right: calc(var(--segment-size) * 0.46);
    }

    .segment-e,
    .segment-f {
      left: calc(var(--segment-size) * 0.46);
    }

    .segment-b,
    .segment-f {
      top: calc(var(--segment-size) * 0.86);
    }

    .segment-c,
    .segment-e {
      bottom: calc(var(--segment-size) * 0.86);
    }

    .counter-digit[data-value="0"] .segment-a,
    .counter-digit[data-value="0"] .segment-b,
    .counter-digit[data-value="0"] .segment-c,
    .counter-digit[data-value="0"] .segment-d,
    .counter-digit[data-value="0"] .segment-e,
    .counter-digit[data-value="0"] .segment-f,
    .counter-digit[data-value="1"] .segment-b,
    .counter-digit[data-value="1"] .segment-c,
    .counter-digit[data-value="2"] .segment-a,
    .counter-digit[data-value="2"] .segment-b,
    .counter-digit[data-value="2"] .segment-d,
    .counter-digit[data-value="2"] .segment-e,
    .counter-digit[data-value="2"] .segment-g,
    .counter-digit[data-value="3"] .segment-a,
    .counter-digit[data-value="3"] .segment-b,
    .counter-digit[data-value="3"] .segment-c,
    .counter-digit[data-value="3"] .segment-d,
    .counter-digit[data-value="3"] .segment-g,
    .counter-digit[data-value="4"] .segment-b,
    .counter-digit[data-value="4"] .segment-c,
    .counter-digit[data-value="4"] .segment-f,
    .counter-digit[data-value="4"] .segment-g,
    .counter-digit[data-value="5"] .segment-a,
    .counter-digit[data-value="5"] .segment-c,
    .counter-digit[data-value="5"] .segment-d,
    .counter-digit[data-value="5"] .segment-f,
    .counter-digit[data-value="5"] .segment-g,
    .counter-digit[data-value="6"] .segment-a,
    .counter-digit[data-value="6"] .segment-c,
    .counter-digit[data-value="6"] .segment-d,
    .counter-digit[data-value="6"] .segment-e,
    .counter-digit[data-value="6"] .segment-f,
    .counter-digit[data-value="6"] .segment-g,
    .counter-digit[data-value="7"] .segment-a,
    .counter-digit[data-value="7"] .segment-b,
    .counter-digit[data-value="7"] .segment-c,
    .counter-digit[data-value="8"] .segment-a,
    .counter-digit[data-value="8"] .segment-b,
    .counter-digit[data-value="8"] .segment-c,
    .counter-digit[data-value="8"] .segment-d,
    .counter-digit[data-value="8"] .segment-e,
    .counter-digit[data-value="8"] .segment-f,
    .counter-digit[data-value="8"] .segment-g,
    .counter-digit[data-value="9"] .segment-a,
    .counter-digit[data-value="9"] .segment-b,
    .counter-digit[data-value="9"] .segment-c,
    .counter-digit[data-value="9"] .segment-d,
    .counter-digit[data-value="9"] .segment-f,
    .counter-digit[data-value="9"] .segment-g {
      background: #f26a1b;
      box-shadow:
        0 0 6px rgba(242, 106, 27, 0.95),
        0 0 18px rgba(242, 106, 27, 0.68),
        0 0 32px rgba(242, 106, 27, 0.32);
      filter: saturate(1.25);
      opacity: 1;
    }

    .counter-labels {
      display: grid;
      width: 100%;
      max-width: 30rem;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-inline: auto;
      text-align: center;
    }

    .counter-scanline {
      pointer-events: none;
      position: absolute;
      inset: 0;
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.11), transparent 17%),
        linear-gradient(180deg, transparent 0 48%, rgba(242, 106, 27, 0.06) 50%, transparent 52%),
        repeating-linear-gradient(180deg, rgba(255, 255, 255, 0.025) 0 1px, transparent 1px 5px);
      mix-blend-mode: screen;
      opacity: 0.55;
    }

    @keyframes counter-field {
      0% { opacity: 0.45; transform: translate3d(-8px, 0, 0); }
      100% { opacity: 0.75; transform: translate3d(8px, 0, 0); }
    }

    @media (prefers-reduced-motion: reduce) {
      .magnet-counter:hover::before {
        animation: none;
      }
    }
  </style>

  <script is:inline>
    document.querySelectorAll('.magnet-counter').forEach((counter) => {
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const timers = new Map();
      const groups = Array.from(counter.querySelectorAll('[data-counter-group]'));
      const randomDigit = () => String(Math.floor(Math.random() * 9) + 1);

      function resetGroup(group) {
        group.classList.remove('is-scrambling');
        group.querySelectorAll('.counter-digit').forEach((digit) => {
          digit.dataset.value = '9';
        });
      }

      function stopGroup(group) {
        const timer = timers.get(group);
        if (timer) {
          window.clearInterval(timer);
          timers.delete(group);
        }
        resetGroup(group);
      }

      function startGroup(group) {
        if (reducedMotion || timers.has(group)) return;
        group.classList.add('is-scrambling');
        const digits = Array.from(group.querySelectorAll('.counter-digit'));
        const scramble = () => {
          digits.forEach((digit) => {
            digit.dataset.value = randomDigit();
          });
        };
        scramble();
        timers.set(group, window.setInterval(scramble, 72));
      }

      groups.forEach((group) => {
        group.addEventListener('mouseenter', () => startGroup(group));
        group.addEventListener('mouseleave', () => stopGroup(group));
      });

      counter.addEventListener('mouseleave', () => {
        groups.forEach(stopGroup);
      });

      counter.addEventListener('mousemove', (event) => {
        const rect = counter.getBoundingClientRect();
        counter.style.setProperty('--mx', `${event.clientX - rect.left}px`);
        counter.style.setProperty('--my', `${event.clientY - rect.top}px`);
      });
    });
  </script>

  <script is:inline>
    (function () {
      const root = document.getElementById('carrusel');
      if (!root) return;
      const track = document.getElementById('carrusel-track');
      const dots = Array.from(root.querySelectorAll('.carrusel-dot'));
      const total = dots.length;
      let idx = 0;
      let timer;

      function render() {
        track.style.transform = `translateX(-${idx * 100}%)`;
        dots.forEach((d, i) => {
          const on = i === idx;
          d.classList.toggle('bg-brand-500', on);
          d.classList.toggle('w-6', on);
          d.classList.toggle('bg-white/40', !on);
        });
      }
      function go(n) { idx = (n + total) % total; render(); }
      function next() { go(idx + 1); }
      function prev() { go(idx - 1); }

      function play() { stop(); timer = setInterval(next, 5000); }
      function stop() { if (timer) clearInterval(timer); }

      document.getElementById('carrusel-next')?.addEventListener('click', () => { next(); play(); });
      document.getElementById('carrusel-prev')?.addEventListener('click', () => { prev(); play(); });
      dots.forEach((d) => d.addEventListener('click', () => { go(Number(d.dataset.idx)); play(); }));
      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', play);

      render();
      play();
    })();
  </script>
</SiteLayout>
